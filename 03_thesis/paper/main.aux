\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Detection delay distribution (boxplot) by drift type and detector. Gradual drift shows both a higher median delay and a wider spread than sudden or recurring drift, across all three detectors.}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:driftdelay}{{2}{3}{Detection delay distribution (boxplot) by drift type and detector. Gradual drift shows both a higher median delay and a wider spread than sudden or recurring drift, across all three detectors}{figure.2}{}}
