\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Mean total computation time (ms) per monitoring run, by detector and window size. PSI's cost is effectively independent of window size (fixed bin structure); KS scales sharply with window size due to repeated sorting and hypothesis-test overhead.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:compute}{{1}{3}{Mean total computation time (ms) per monitoring run, by detector and window size. PSI's cost is effectively independent of window size (fixed bin structure); KS scales sharply with window size due to repeated sorting and hypothesis-test overhead}{figure.1}{}}
