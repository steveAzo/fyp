\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Mean detection delay (samples) by monitoring frequency $\times $ window size, faceted by detector. The pattern is consistent across all three detectors: delay grows with both coarser monitoring frequency and larger window size, and the two effects compound.}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:heatmap}{{3}{4}{Mean detection delay (samples) by monitoring frequency $\times $ window size, faceted by detector. The pattern is consistent across all three detectors: delay grows with both coarser monitoring frequency and larger window size, and the two effects compound}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Detection delay as a function of monitoring frequency, with one line per window size, faceted by detector. The near-parallel, non-overlapping curves show that window size and monitoring frequency act as largely independent, additive levers on detection delay.}}{4}{figure.4}\protected@file@percent }
\newlabel{fig:tradeoff}{{4}{4}{Detection delay as a function of monitoring frequency, with one line per window size, faceted by detector. The near-parallel, non-overlapping curves show that window size and monitoring frequency act as largely independent, additive levers on detection delay}{figure.4}{}}
